{
  "name": "oriz-convert",
  "type": "module",
  "version": "1.0.0",
  "description": "Universal converter — CSV/JSON/YAML/XML, units, number bases, color formats. 100% client-side.",
  "license": "MIT",
  "author": "Chirag Singhal",
  "scripts": {
