    "@chirag127/oz-tokens-base": "file:../design-system/packages/oz-tokens-base",
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@tailwindcss/vite": "^4.1.13",
    "astro": "^6.4.8",
    "fast-xml-parser": "^5.2.5",
    "js-yaml": "^4.1.0",
    "papaparse": "^5.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.13"
