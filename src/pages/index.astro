---
import Base from '../layouts/Base.astro'
import ConverterApp from '../components/ConverterApp.tsx'
---

<Base>
  <div class="hero">
    <p class="hero__eyebrow">Transmutation Lab</p>
    <h1 class="hero__title">Free online <em>converter</em></h1>
    <p class="hero__sub">
      CSV, JSON, YAML, XML, units, number bases and color formats — converted instantly in your browser.
      No upload, no signup, nothing stored. Everything runs on your machine.
    </p>
  </div>

  <ConverterApp client:load />
</Base>
