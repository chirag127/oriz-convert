---
import '@chirag127/oz-tokens-base'
import '@chirag127/oz-chrome/styles.css'
import '../styles/theme.css'
import '../styles/app.css'
import OzToolShell from '@chirag127/oz-chrome/components/OzToolShell.astro'

interface Props {
  title?: string
  description?: string
}
const {
  title = 'oriz-convert — Universal Converter',
  description = 'Transmute data between CSV, JSON, YAML, XML. Convert units, number bases, and color formats. 100% client-side — nothing leaves your browser.',
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#0d0716" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline src="/registerSW.js"></script>
  </head>
  <body>
    <OzToolShell site="convert" title="Universal Converter" wordmarkHref="https://oriz.in">
      <a slot="nav" href="https://oriz.in">oriz.in</a>
      <slot />
      <Fragment slot="footer">
        <a href="https://github.com/chirag127/oriz-convert">Source</a>
        <span>100% client-side · no upload · no signup</span>
      </Fragment>
    </OzToolShell>
  </body>
</html>
